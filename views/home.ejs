<%- include('header') %><% /* Restore the reference's editorial sections while retaining current data helpers. */ const lead=hero; latest=all.filter(item=>item.id!==lead?.id).slice(0,6); culture=all.filter(item=>item.category==='cultura-e-turismo'&&item.id!==lead?.id).slice(0,3); digests=['politica','economia-e-agro'].map(key=>({key,stories:all.filter(item=>item.category===key&&item.id!==lead?.id).slice(0,3)})).filter(section=>section.stories.length); %><main id="main" class="container home-main"><div class="edition-line"><span><span class="live-dot"></span> CONEXÃO TOCANTINS</span><span class="edition-date"><%= today %></span><% if(all.some(a=>a.demo)){ %><span class="demo-edition">EDIÇÃO DEMONSTRATIVA</span><% } %></div><% const urgent=all.find(a=>a.urgent); if(urgent){ %><div class="breaking"><strong>PLANTÃO</strong><a href="/noticia/<%= urgent.slug %>"><%= urgent.title %></a></div><% } %><h1 class="sr-only">Giro63 — notícias do Tocantins</h1><% if(all.length){ %><div class="news-ticker"><a class="ticker-label" href="/ultimas">ÚLTIMAS</a><a class="ticker-story" href="/noticia/<%= all[0].slug %>"><%= all[0].title %></a></div><% } %>
<% if(hero){const cover=editorialImage(hero.photo_cover||hero.cover); %><section class="lead-grid" aria-label="Principais notícias"><article class="lead-story featured-story"><% if(hero){ %><a href="/noticia/<%= hero.slug %>" class="featured-link"><img src="<%= cover.src %>" srcset="<%= cover.srcset %>" sizes="(max-width:760px) 100vw,70vw" alt="<%= hero.cover_alt||hero.title %>" width="1100" height="680" fetchpriority="high"><div class="featured-content"><span class="featured-category"><%= categoryName(hero.category) %></span><% if(hero.demo){ %><span class="featured-demo">CONTEÚDO DEMONSTRATIVO</span><% } %><h2><%= hero.title %></h2><p><%= hero.summary %></p><div class="featured-byline"><span>Por <%= hero.byline||'Redação Giro63' %></span><span><%= formatDate(hero.published_at) %></span></div></div></a><% }else{ %><a href="/noticia/<%= hero.slug %>" class="lead-image"><img src="<%= cover.src %>" srcset="<%= cover.srcset %>" sizes="(max-width:760px) 100vw,70vw" alt="Imagem de capa de <%= hero.title %>" width="1100" height="680" fetchpriority="high"><% if(hero.demo){ %><span class="image-label">CONTEÚDO DEMONSTRATIVO</span><% } %></a><div class="eyebrow"><a href="/editoria/<%= hero.category %>"><%= categoryName(hero.category) %></a><% if(hero.city){ %><span class="dot-divider">•</span><%= hero.city %><% } %></div><h2><a href="/noticia/<%= hero.slug %>"><%= hero.title %></a></h2><p><%= hero.summary %></p><div class="lead-byline"><span>Por <%= hero.byline||'Redação Giro63' %></span><span><%= formatDate(hero.published_at) %></span></div><% } %></article><aside class="top-stories" aria-label="Outras notícias"><% sidebarStories.forEach(item=>{ const image=editorialImage(item.photo_thumb||item.cover); %><article class="side-story"><a href="/noticia/<%= item.slug %>" class="side-image"><img src="<%= image.src %>" srcset="<%= image.srcset %>" sizes="(max-width:540px) 105px,112px" alt="<%= item.cover_alt||'Imagem de capa de '+item.title %>" width="220" height="220"></a><div class="side-copy"><div class="eyebrow"><a href="/editoria/<%= item.category %>"><%= categoryName(item.category) %></a></div><h3><a href="/noticia/<%= item.slug %>"><%= item.title %></a></h3><time class="side-time" datetime="<%= item.published_at %>"><%= shortPublication(item.published_at) %></time><% if(item.demo){ %><span class="side-demo">Conteúdo demonstrativo</span><% } %></div></article><% }) %></aside></section><% }else{ %><section class="empty-state"><h2>Novas histórias estão a caminho.</h2><p>A redação está preparando as primeiras publicações.</p></section><% } %><%- include('weather') %><%- include('ad',{position:'top'}) %>
<% if(latest.length){ %><section class="news-section"><div class="section-heading"><div><span class="tiny-label">NO RITMO DO SEU DIA</span><h2>O último giro.</h2></div><a class="underlined-link" href="/ultimas">Todas as notícias</a></div><div class="news-grid" data-count="<%= latest.length %>"><% latest.forEach(item=>{ %><%- include('card',{item}) %><% }) %></div></section><% } %>
<div class="cities-ranking"><section class="cities-section" aria-labelledby="cities-title"><span class="tiny-label">CADA CIDADE, UMA HISTÓRIA</span><h2 id="cities-title">O Tocantins de perto</h2><p>Encontre as histórias da sua região.</p><div class="city-finder" hidden><label for="city-search">Encontre sua cidade ou região</label><input id="city-search" type="search" placeholder="Digite o nome da cidade" autocomplete="off"></div><div class="city-links"><% cities.forEach((city,i)=>{ %><a href="/cidade/<%= slugify(city) %>" data-city-name="<%= city %>"><span class="city-index"><%= String(i+1).padStart(2,'0') %></span><span><%= city %></span></a><% }) %></div><p class="city-empty" role="status" hidden>Nenhuma cidade encontrada. Tente outro nome.</p></section><%- include('most-read') %></div>
<% if(digests.length){ %><section class="editoria-digest" aria-label="Destaques por editoria"><% digests.forEach(({key,stories})=>{ %><div class="digest-column"><div class="digest-heading"><h2><%= categoryName(key) %></h2><a href="/editoria/<%= key %>" aria-label="Ver todas as notícias de <%= categoryName(key) %>">Ver todas</a></div><% stories.forEach(item=>{const image=editorialImage(item.photo_thumb||item.cover); %><article class="digest-story"><a href="/noticia/<%= item.slug %>"><img src="<%= image.src %>" srcset="<%= image.srcset %>" sizes="120px" alt="<%= item.cover_alt||'Imagem de capa de '+item.title %>" loading="lazy" width="140" height="105"></a><div><% if(item.city||item.demo){ %><span class="tiny-label"><%= item.city %><%= item.demo?' · Demonstração':'' %></span><% } %><h3><a href="/noticia/<%= item.slug %>"><%= item.title %></a></h3></div></article><% }) %></div><% }) %></section><% } %>
<% if(culture.length){ %><section class="news-section"><div class="section-heading"><div><span class="tiny-label">IDENTIDADE E PERTENCIMENTO</span><h2>Da nossa terra.</h2></div><a class="underlined-link" href="/editoria/cultura-e-turismo">Cultura e Turismo</a></div><div class="news-grid" data-count="<%= culture.length %>"><% culture.forEach(item=>{ %><%- include('card',{item}) %><% }) %></div></section><% } %><%- include('ad',{position:'middle'}) %>
<section class="social-banner"><span class="social-orbit" aria-hidden="true">◎</span><div><span class="tiny-label">A CONVERSA CONTINUA</span><h2>O giro também acontece no Instagram.</h2><p>Acompanhe as histórias do Tocantins.</p></div><% if(settings.instagram){ %><a class="button button-light" href="<%= settings.instagram %>" target="_blank" rel="noopener noreferrer">Acompanhe o Giro63</a><% }else{ %><div class="social-coming"><span class="tiny-label">EM BREVE</span><p>Nosso perfil está em preparação.</p></div><% } %></section></main><%- include('footer') %>