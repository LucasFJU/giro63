<%- include('header') %><main id="main" class="container admin-main"><div class="page-heading"><span class="tiny-label">ASSUNTOS DO PORTAL</span><h1>Tags</h1><p>Tags organizam assuntos sem alterar as editorias do menu. Renomear preserva o endereço.</p></div><%- include('directory-controls') %><% if(error){ %><p class="form-error" role="alert"><%= error %></p><% } %><details class="admin-add"><summary>Adicionar tag</summary><form method="post" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="new-tag">Nova tag</label><input id="new-tag" name="name" maxlength="50" required><button class="button" name="action" value="create">Criar tag</button></form></details><% items.forEach(tag=>{ %><div class="directory-row"><strong><%= tag.name %></strong><a class="button secondary" href="<%= directoryLink(page,tag.slug) %>">Editar</a></div><% if(edit===tag.slug){ %><section class="directory-editor"><form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="slug" value="<%= tag.slug %>"><label for="name-<%= tag.slug %>">Nome</label><input id="name-<%= tag.slug %>" name="name" value="<%= tag.name %>" maxlength="50"><button class="button secondary" name="action" value="rename">Renomear</button><button data-confirm="Remover esta tag de todas as matérias? Os textos serão preservados." class="button secondary" name="action" value="delete">Remover tag das matérias</button><label for="merge-<%= tag.slug %>">Unificar com</label><select id="merge-<%= tag.slug %>" name="target"><option value="">Selecione o destino</option><% allItems.filter(t=>t.slug!==tag.slug).forEach(t=>{ %><option value="<%= t.slug %>"><%= t.name %></option><% }) %></select><button data-confirm="Unificar as associações na tag selecionada? A tag de origem será removida." class="button secondary" name="action" value="merge">Unificar associações</button></form></section><% } %><% }) %><% if(!items.length){ %><p class="empty-state">As tags aparecerão aqui quando forem criadas pela redação ou pela automação.</p><% } %><%- include('directory-pagination') %></main><%- include('footer') %>
