<%- include('header') %><main id="main" class="container admin-main"><div class="page-heading"><span class="tiny-label">ASSUNTOS DO PORTAL</span><h1>Tags</h1><p>Tags organizam assuntos sem alterar as editorias do menu. Renomear preserva o endereço.</p></div><% if(error){ %><p class="form-error" role="alert"><%= error %></p><% } %><form method="post" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="new-tag">Nova tag</label><input id="new-tag" name="name" maxlength="50" required><button class="button" name="action" value="create">Criar tag</button></form><% tags.forEach(tag=>{ %><section class="form-card"><form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="slug" value="<%= tag.slug %>"><label for="name-<%= tag.slug %>">Nome</label><input id="name-<%= tag.slug %>" name="name" value="<%= tag.name %>" maxlength="50"><button class="button secondary" name="action" value="rename">Renomear</button><button class="button secondary" name="action" value="delete">Remover tag das matérias</button><label for="merge-<%= tag.slug %>">Unificar com</label><select id="merge-<%= tag.slug %>" name="target"><option value="">Selecione o destino</option><% tags.filter(t=>t.slug!==tag.slug).forEach(t=>{ %><option value="<%= t.slug %>"><%= t.name %></option><% }) %></select><button class="button secondary" name="action" value="merge">Unificar associações</button></form></section><% }) %><% if(!tags.length){ %><p class="empty-state">As tags aparecerão aqui quando forem criadas pela redação ou pela automação.</p><% } %></main><%- include('footer') %>
