<%- include('header') %><main id="main" class="container article-main"><div class="article-page-shell"><div class="breadcrumb"><a href="/">Início</a><span>/</span><a href="/editoria/<%= article.category %>"><%= categoryName(article.category) %></a></div>
<div class="article-page-grid"><div class="article-reading">
<% if(preview){ %><div class="notice">PRÉVIA INTERNA · Esta versão ainda não é uma publicação pública. <a href="/admin/noticias/<%= article.id %>">Voltar à edição</a></div><% } %>
<% if(article.demo){ %><div class="demo-notice"><strong>Conteúdo demonstrativo</strong><span>Exemplo de layout e leitura. Esta matéria não relata fatos apurados.</span></div><% } %>
<header class="article-header" id="article-title"><div class="eyebrow"><%= categoryName(article.category) %><% if(article.city){ %><span class="dot-divider">•</span><a href="/cidade/<%= slugify(article.city) %>"><%= article.city %></a><% } %><% if(article.urgent){ %><span class="urgent-label">PLANTÃO</span><% } %></div><h1><%= article.title %></h1><p class="article-summary"><%= article.summary %></p><div class="article-meta"><div><span class="reading-time"><%= readingMinutes(article.body) %> min de leitura</span><strong>Por <%= article.byline||article.author_name||user?.name||'Redação Giro63' %></strong><span><%= article.published_at?'Publicado em '+formatDate(article.published_at):'Rascunho não publicado' %><% if(article.updated_at!==article.published_at&&article.published_at){ %> · Atualizado em <%= formatDate(article.updated_at) %><% } %></span></div></div></header>
<% if(!preview){ const quickUrl=metadata?.url||'http://localhost:'+(process.env.PORT||3000)+'/noticia/'+article.slug; %><nav class="article-quick-share" aria-label="Compartilhar notícia"><a class="quick-facebook" aria-label="Compartilhar no Facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(quickUrl) %>" target="_blank" rel="noopener noreferrer"><%- include('share-icon',{icon:'facebook'}) %><span>Facebook</span></a><a class="quick-whatsapp" aria-label="Compartilhar no WhatsApp" href="https://wa.me/?text=<%= encodeURIComponent(article.title+' '+quickUrl) %>" target="_blank" rel="noopener noreferrer"><%- include('share-icon',{icon:'whatsapp'}) %><span>WhatsApp</span></a><a class="quick-more" aria-label="Ver opções de compartilhamento" href="#article-social-title"><%- include('share-icon',{icon:'share'}) %><span>Compartilhar</span></a></nav><% } %>
<figure class="article-cover"><img src="<%= editorialImage(article.cover).src %>" srcset="<%= editorialImage(article.cover).srcset %>" sizes="(max-width:1000px) 100vw,760px" alt="<%= article.cover_alt||article.title+' — imagem de capa' %>" width="<%= editorialImage(article.cover).width||1400 %>" height="<%= editorialImage(article.cover).height||850 %>"><figcaption><%= article.credit||'Crédito da imagem a preencher antes da publicação.' %><% if(article.cover==='/images/jalapao.jpg'){ %> <a href="https://commons.wikimedia.org/wiki/File:Dunas_-_Jalap%C3%A3o_-_Tocantins_-_Brasil.jpg" target="_blank" rel="noopener noreferrer">Original</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener noreferrer">Licença CC BY-SA 3.0</a><% }else if(article.cover==='/images/palmas.jpg'){ %> <a href="https://commons.wikimedia.org/wiki/File:Pra%C3%A7a_dos_girassois,_Palmas-TO.jpg" target="_blank" rel="noopener noreferrer">Original</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">Licença CC BY-SA 4.0</a><% } %></figcaption></figure>
<article class="article-body"><%- article.body %><% if(article.sources){ %><aside class="sources"><h2>Fontes e referências</h2><p><%= article.sources %></p></aside><% } %><div class="article-end"><span class="tiny-label">INFORMAÇÃO QUE APROXIMA.</span><a href="/pagina/contato">Quer falar com a redação?</a></div></article>
<%- include('article-sharing') %>
</div>
<aside class="article-page-aside" aria-label="Mais informações e publicidade"><div class="sidebar-note"><span class="tiny-label">SEU ESTADO, POR INTEIRO</span><h2>Um olhar mais próximo.</h2><p>Acompanhe as histórias que conectam o Tocantins.</p><a href="/ultimas" class="underlined-link">Últimas notícias</a></div><%- include('ad',{position:'sidebar'}) %></aside>
</div></div>
<% if(!preview){ %><div class="article-ranking"><%- include('most-read') %></div><% } %>
<% if(related.length){ %><section class="news-section"><div class="section-heading"><div><span class="tiny-label">CONTINUE A LEITURA</span><h2>Outras perspectivas<span>.</span></h2></div></div><div class="news-grid" data-count="<%= related.length %>"><% related.forEach(item=>{ %><%- include('card',{item}) %><% }) %></div></section><% } %></main><%- include('footer') %>
