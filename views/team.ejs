<%- include('header') %><main id="main" class="container admin-main"><div class="page-heading"><span class="tiny-label">QUEM FAZ O GIRO</span><h1>Equipe<span>.</span></h1><p>Acessos individuais para uma rotina editorial organizada.</p></div><% if(error){ %><div class="form-error" role="alert"><%= error %></div><% } %><div class="edit-layout"><div class="table-wrap"><table><thead><tr><th>Pessoa</th><th>Perfil</th><th>Acesso</th><th>Ação</th></tr></thead><tbody><% members.forEach(m=>{ %><tr><td><strong><%= m.name %></strong><span class="table-subtitle"><%= m.email %></span></td><td><%= m.role==='editor'?'Editor':'Autor' %></td><td><%= m.active?'Ativo':'Inativo' %></td><td><% if(m.id!==user.id){ %><form method="post" action="/admin/equipe/<%= m.id %>/alternar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button"><%= m.active?'Desativar':'Reativar' %></button></form><% }else{ %>Você<% } %></td></tr><% }) %></tbody></table></div><details class="admin-add"><summary>Adicionar pessoa</summary><form method="post" class="form-card"><h2>Novo acesso</h2><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="name">Nome</label><input id="name" name="name" required maxlength="100"><label for="email">E-mail</label><input id="email" type="email" name="email" autocomplete="off" required maxlength="200"><label for="password">Senha inicial</label><input id="password" type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="200"><p class="field-help">Use uma senha única com pelo menos 12 caracteres.</p><label for="role">Perfil</label><select id="role" name="role"><option value="author">Autor · escreve e envia para revisão</option><option value="editor">Editor · revisa, publica e administra</option></select><button class="button full-width">Cadastrar pessoa</button></form></details></div></main><%- include('footer') %>
