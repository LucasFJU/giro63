<% if(typeof sourceItem!=='undefined'&&sourceItem){const codes=JSON.parse(sourceItem.blockers||'[]');const descriptions={SOURCE_UNAUTHORIZED:'Permissão de reutilização específica da fonte/conteúdo',INSUFFICIENT_FACTS:'Informações essenciais ao fato conferidas e complementadas',DUPLICATE:'Possível duplicidade investigada e resolvida',UNCONFIRMED_NUMBER:'Números conferidos na fonte ou em referência registrada',UNCONFIRMED_QUOTE:'Citações conferidas no original',GENERATION_FAILED:'Texto preparado e conferido manualmente',INVALID_CONTENT:'Conteúdo corrigido e validado',LEGACY_REVIEW:'Texto e alertas da versão anterior integralmente conferidos',ATTRIBUTION_LOST:'Atribuições e condição de suspeita preservadas'}; %>
<div class="notice editorial-review-notice"><strong><%= article.status==='published'&&sourceItem.review_pending?'Publicado — conferir':'Conferência editorial da automação' %></strong><p>A fotografia precisa de crédito, licença e aprovação de contexto. Aprovar a foto e salvar rascunho mantém a matéria fora do ar. Temas sensíveis podem ser publicados com conferência posterior, após resolver os bloqueios.</p></div>
<% if(codes.some(c=>c!=='IMAGE_PENDING')){ %><details open><summary>Bloqueios do texto — conferir antes de publicar</summary><p class="field-help">Marque somente o que você verificou. Registre a referência ou correção; as verificações automáticas não são apuração independente.</p><% codes.filter(c=>descriptions[c]).forEach(c=>{ %><label class="checkbox-label"><input type="checkbox" name="resolved_issues" value="<%= c %>"> <%= descriptions[c] %></label><% });if(codes.includes('UNKNOWN_ALERT')){ %><label class="checkbox-label"><input type="checkbox" name="resolved_issues" value="UNKNOWN_ALERT"> Classifiquei o alerta recebido</label><label for="classify-unknown">Classificar alerta desconhecido</label><select id="classify-unknown" name="classify_unknown"><option value="">Manter bloqueio</option value="INVALID_CONTENT">Conteúdo inválido — bloquear até corrigir</option><option value="SHORT_COMPLETE">Texto curto, informação completa — conferência posterior</option><option value="SENSITIVE">Tema sensível — conferência posterior</option></select><label class="checkbox-label"><input type="checkbox" name="resolved_issues" value="INVALID_CONTENT"> Conteúdo corrigido e conferido, se esta foi a classificação</label><% } %><label for="resolution-note">Referências e correções verificadas (mínimo 20 caracteres)</label><textarea id="resolution-note" name="resolution_note" rows="3" maxlength="2000"></textarea></details><% } %>
<details><summary>Autorização da fotografia</summary><label class="checkbox-label"><input type="checkbox" name="editorial_image_rights"> Confirmei a autorização desta fotografia</label><label class="checkbox-label"><input type="checkbox" name="editorial_image_context"> Confirmei a relação desta fotografia com a notícia</label></details>
<% if(sourceItem.review_pending){ %><p class="field-help"><strong>Pendências de conferência posterior:</strong> <%= JSON.parse(sourceItem.review_reasons||'[]').map(c=>({SENSITIVE:'Tema sensível',TAGS:'Tags sugeridas',CITY_ABSENT:'Cidade ausente',SHORT_COMPLETE:'Texto curto',SOURCE_UPDATED:'Fonte atualizada'}[c]||c)).join(' · ') %></p><% } %><% if(sourceItem.resolution_note){ %><details><summary>Última conferência registrada</summary><p><%= sourceItem.resolution_note %></p><p><%= sourceItem.reviewed_at %> · editor <%= sourceItem.reviewed_by %></p></details><% } %>
<% } %>
