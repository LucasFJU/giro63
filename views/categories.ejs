<%- include('header') %><main id="main" class="container admin-main"><div class="page-heading"><span class="tiny-label">ORGANIZAÇÃO EDITORIAL</span><h1>Categorias</h1><p>Organize a cobertura e escolha quais editorias aparecem no menu do portal.</p></div><%- include('directory-controls') %><% if(error){ %><div class="form-error" role="alert"><%= error %></div><% } %><div class="category-layout"><section class="category-list"><% items.forEach(item=>{ %><div class="directory-row"><strong><%= item.name %></strong><a class="button secondary" href="<%= directoryLink(page,item.slug) %>">Editar</a></div><% if(edit===item.slug){ %><section class="directory-editor"><form method="post" action="/admin/categorias/<%= item.slug %>" class="form-card category-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label for="name-<%= item.slug %>">Nome</label><input id="name-<%= item.slug %>" name="name" value="<%= item.name %>" required maxlength="80"><p class="field-help">/editoria/<%= item.slug %> · <%= item.total %> matérias</p></div><div><label for="order-<%= item.slug %>">Ordem</label><input id="order-<%= item.slug %>" type="number" name="position" value="<%= item.position %>" min="0" max="999" required></div><label class="checkbox-label"><input type="checkbox" name="show_menu" <%= item.show_menu?'checked':'' %>> Exibir no menu</label><button class="button secondary">Salvar</button></form></section><% } %><% }) %></section><details class="admin-add"><summary>Adicionar categoria</summary><form method="post" action="/admin/categorias" class="form-card"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Nova categoria</h2><label for="category-name">Nome da editoria</label><input id="category-name" name="name" required maxlength="80" placeholder="Ex.: Educação"><p class="field-help">O endereço será criado a partir do nome. A categoria ficará disponível no editor de matérias.</p><label class="checkbox-label"><input type="checkbox" name="show_menu"> Exibir no menu público</label><button class="button full-width">Criar categoria</button></form></details></div><%- include('directory-pagination') %></main><%- include('footer') %>