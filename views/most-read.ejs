<section class="most-read" aria-labelledby="most-read-title"><div class="most-read-heading"><div><span class="tiny-label">NO RADAR DOS LEITORES</span><h2 id="most-read-title">Mais lidas</h2></div><span>Últimos 7 dias</span></div><% if(mostRead.length){ %><ol><% mostRead.forEach((item,index)=>{ const picture=editorialImage(item.cover); %><li><a href="/noticia/<%= item.slug %>"><span class="most-read-number" aria-hidden="true"><%= String(index+1).padStart(2,'0') %></span><span class="most-read-copy"><strong><%= item.title %></strong><% if(item.demo){ %><small>Demonstração</small><% } %></span><img src="<%= picture.src %>" srcset="<%= picture.srcset %>" sizes="64px" alt="" loading="lazy" width="64" height="48"></a></li><% }) %></ol><% }else{ %><p class="ranking-empty">As matérias mais lidas aparecerão aqui conforme receberem acessos.</p><a href="/ultimas" class="underlined-link">Explorar últimas notícias</a><% } %></section>