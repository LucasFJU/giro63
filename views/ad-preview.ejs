<%- include('header') %><main id="main" class="container admin-main"><div class="section-heading"><div><span class="tiny-label">PRÉVIA ADMINISTRATIVA</span><h1><%= item.name %></h1><p><%= adPositions[item.position] %> · Simulação sem medição e sem alterar o rodízio.</p></div><a class="button secondary" href="/admin/publicidade/<%= item.id %>">Voltar à campanha</a></div><div class="ad-simulation form-card <%= item.position==='sidebar'?'simulation-sidebar':'' %>"><div class="simulation-content">Conteúdo editorial</div><aside class="ad-slot ad-<%= item.position %> simulation-ad"><span class="ad-caption">PUBLICIDADE</span><img src="<%= item.image %>" alt="<%= item.alt %>"></aside><div class="simulation-content">Continuação da leitura</div></div><% if(item.link){ %><p class="field-help">Destino: <%= item.link %></p><% } %></main><%- include('footer') %>