<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= settings.name %></title>
  <meta name="description" content="<%= description %>">
  <meta name="theme-color" content="#ED521A">
  <meta property="og:title" content="<%= title %> | <%= settings.name %>"><meta property="og:description" content="<%= description %>"><meta property="og:locale" content="pt_BR"><meta property="og:site_name" content="<%= settings.name %>">
  <% if(metadata){ %><link rel="canonical" href="<%= metadata.url %>"><meta property="og:url" content="<%= metadata.url %>"><meta property="og:type" content="<%= metadata.type %>"><meta property="og:image" content="<%= metadata.image %>"><meta name="twitter:card" content="summary_large_image"><% if(typeof article!=='undefined'&&article.photo_share){ %><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:type" content="image/webp"><% } %><% if(typeof article!=='undefined'&&article.cover_alt){ %><meta property="og:image:alt" content="<%= article.cover_alt %>"><% } %><% } %>
  <% if(noindex){ %><meta name="robots" content="noindex,nofollow"><% } %>
  <link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32"><link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16"><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180"><link rel="manifest" href="/site.webmanifest"><meta name="csrf-token" content="<%= csrf %>"><meta name="audience-token" content="<%= audienceToken %>"><meta name="form-errors" content="<%= JSON.stringify(fieldErrors||{}) %>">
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/brand.css"><script src="/app.js" defer></script><script src="/ad-metrics.js" defer></script>
<% if(path.startsWith('/admin')&&user&&!path.endsWith('/preview')){ %><link rel="stylesheet" href="/admin.css"><script src="/admin.js" defer></script><script src="/article-images.js" defer></script><% } %>
<% if(path==='/admin/login'){ %><link rel="stylesheet" href="/login.css"><script src="/login.js" defer></script><% } %>
<% if(path.startsWith('/admin/publicidade')&&user){ %><link rel="stylesheet" href="/campaigns.css"><script src="/campaigns.js" defer></script><% } %>
<% if(!path.startsWith('/admin')||path.endsWith('/preview')){ %><link rel="stylesheet" href="/reader.css"><script src="/reader.js" defer></script><% } %>
<% if(path==='/admin/automacao'){ %><link rel="stylesheet" href="/automation.css"><% } %><link rel="stylesheet" href="/portal.css"><script src="/portal.js" defer></script><script src="/forms.js" defer></script>
<% if(path==='/admin/audiencia'&&user){ %><link rel="stylesheet" href="/audience.css?v=20261107"><% } %>
</head>
<body class="<%= path.startsWith('/admin') ? 'admin-body' : '' %><%= path==='/admin/login'?' login-page':'' %>">
<a class="skip-link" href="#main">Pular para o conteúdo</a>
<div class="site-header" id="site-header">
<header class="masthead">
  <div class="container masthead-inner">
    <div class="masthead-message"><span class="tiny-label"><%= settings.tagline.replace(/[.]+$/, '') %></span></div>
    <a class="wordmark" href="/" aria-label="<%= settings.name %> — página inicial"><% if(settings.name==='Giro63'){ %><img src="/images/giro63-logo-branca.webp" alt="GIRO63" width="280" height="93"><% }else{ %><%= settings.name %><% } %></a>
    <div class="masthead-actions"><% if(settings.instagram){ %><div class="header-social"><a href="<%= settings.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg></a></div><% } %><div class="header-search"><button type="button" class="search-toggle" aria-label="Abrir busca" aria-expanded="false" aria-controls="site-search"><svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><g class="search-open-icon"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></g><path class="search-close-icon" d="m6 6 12 12M18 6 6 18"/></svg></button><div id="site-search" class="search-panel"><form action="/busca" class="search-form" role="search"><label for="global-q" class="sr-only">Buscar notícias</label><input id="global-q" type="search" name="q" autocomplete="off" placeholder="O que você procura?" maxlength="100" required><button class="button" type="submit">Buscar</button></form></div></div><a href="/pagina/anuncie" class="masthead-advertise">Anuncie</a></div>
  </div>
</header>
<nav class="main-nav" aria-label="Navegação principal"><div class="container nav-inner">
  <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links">☰ <span>Editorias</span></button>
  <div id="nav-links" class="nav-links"><a class="<%= path==='/'?'active':'' %>" href="/">Início</a><a class="<%= path==='/ultimas'?'active':'' %>" href="/ultimas">Últimas</a><% navCategories.forEach(([slug,name])=>{ %><a data-nav-category class="<%= path==='/editoria/'+slug?'active':'' %>" href="/editoria/<%= slug %>"><%= name %></a><% }) %><div class="nav-more" hidden><button type="button" class="nav-more-toggle" aria-expanded="false" aria-controls="more-editorias">Mais</button><div id="more-editorias" class="nav-more-panel" hidden></div></div><a class="mobile-advertise-link" href="/pagina/anuncie">Anuncie</a></div>
</div></nav>
</div>
<% if(path.startsWith('/admin')&&user&&!path.endsWith('/preview')){ %><%- include('admin-nav') %><% } %>
<% if(flash){ %><div class="container"><div class="flash" role="status"><%= flash %></div></div><% } %>
