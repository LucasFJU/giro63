<article class="news-card"><a href="/noticia/<%= item.slug %>" class="card-image"><img src="<%= editorialImage(item.photo_thumb||item.cover).src %>" srcset="<%= editorialImage(item.photo_thumb||item.cover).srcset %>" sizes="(max-width:480px) 100vw,(max-width:1000px) 50vw,25vw" alt="<%= item.cover_alt||'Imagem de capa de '+item.title %>" loading="lazy" width="640" height="420"><% if(!item.demo&&/arquivo|ilustrativ/i.test(item.photo_caption||'')){ %><span class="image-label">IMAGEM ILUSTRATIVA</span><% } %><% if(item.demo){ %><span class="image-label">DEMONSTRAÇÃO</span><% } %></a><div class="card-content"><div class="eyebrow"><a href="/editoria/<%= item.category %>"><%= categoryName(item.category) %></a><% if(item.city){ %><span class="dot-divider">•</span><a href="/cidade/<%= slugify(item.city) %>"><%= item.city %></a><% } %></div><h3><a href="/noticia/<%= item.slug %>"><%= item.title %></a></h3><p><%= item.summary %></p><span class="article-time"><%= formatDate(item.published_at) %></span></div></article>
