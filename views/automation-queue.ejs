<% const tabs=[['pending','Precisa de atenção',(counts.review||0)+(counts.failed||0)],['queued','Na fila',(counts.queued||0)+(counts.processing||0)],['published','Publicados',counts.published||0],['discarded','Descartados',counts.discarded||0],['all','Todos',Object.values(counts).reduce((a,b)=>a+b,0)]]; const states={review:'Revisão necessária',failed:'Falha na geração',queued:'Aguardando geração',processing:'Em processamento',published:'Publicado',discarded:'Descartado'}; %>
<section class="automation-overview" aria-label="Resumo da automação"><div><span>Precisa de atenção</span><strong><%= (counts.review||0)+(counts.failed||0) %></strong><small>Itens para conferir antes de publicar</small></div><div><span>Publicações de hoje</span><strong><%= daily.published %><small> / 10</small></strong><small>Até 3 nacionais · horário de São Paulo</small></div><div><span>Funcionamento</span><strong class="automation-mode"><%= settings.automation_paused==='0'?'Coleta ativa':'Coleta pausada' %></strong><small><%= settings.automation_publish==='1'?'Publicação dos itens elegíveis habilitada':'Publicação automática desligada' %></small></div></section>
<section class="automation-manager" id="automation-queue" aria-labelledby="queue-title"><div class="automation-heading"><div><h2 id="queue-title">Central de revisão</h2><p>Confira as pendências e acompanhe cada etapa da coleta.</p></div><a class="button secondary" href="/admin/materias?status=review">Matérias em revisão</a></div>
<nav class="automation-tabs" aria-label="Situação dos itens"><% tabs.forEach(([key,name,n])=>{ %><a href="<%= queueLink(key) %>" <%- filter===key?'aria-current="page"':'' %>><%= name %><span><%= n %></span></a><% }) %></nav>
<form class="automation-filters" action="/admin/automacao#automation-queue" method="get"><input type="hidden" name="status" value="<%= filter %>"><div><label for="automation-search">Buscar por título ou fonte</label><input id="automation-search" name="q" type="search" value="<%= q %>" maxlength="100" placeholder="Digite um assunto ou título"></div><div><label for="automation-source">Fonte</label><select id="automation-source" name="source"><option value="">Todas as fontes</option><% sources.forEach(s=>{ %><option value="<%= s.id %>" <%= sourceFilter===s.id?'selected':'' %>><%= s.name %></option><% }) %></select></div><button class="button">Buscar</button><% if(q||sourceFilter){ %><a href="/admin/automacao?status=<%= filter %>#automation-queue">Limpar filtros</a><% } %></form>
<p class="automation-result-count" role="status"><%= total %> <%= total===1?'item encontrado':'itens encontrados' %><% if(total){ %> · Página <%= page %> de <%= pages %><% } %></p>
<div class="automation-items"><% items.forEach(item=>{const needsAttention=['review','failed'].includes(item.state); %><article class="automation-item"><div class="automation-item-main"><span class="automation-badge automation-badge-<%= item.state %>"><%= states[item.state]||item.state %></span><h3><%= item.title %></h3><p class="automation-origin"><%= item.source_name %> · <time><%= formatDate(item.original_at) %></time></p>
<% if(needsAttention){ %><p class="automation-reason"><%= item.note||'Confira o conteúdo e a fonte antes de publicar.' %></p><% if(!item.article_id){ %><p class="automation-next-step">Sem matéria criada. Use o botão para abrir um rascunho e preparar o texto manualmente. O material da fonte está nos detalhes abaixo.</p><% } %><% } %>
<details class="automation-item-details"><summary>Ver fonte e detalhes</summary><div><a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">Abrir publicação original</a><% if(!needsAttention&&item.note){ %><h4>Registro editorial</h4><p><%= item.note %></p><% } %><h4>Material recebido da fonte</h4><p class="automation-source-text"><%= item.summary %></p><p class="automation-attempts">Tentativas de geração: <%= item.attempts %> de 2</p></div></details></div>
<div class="automation-item-actions"><% if(item.article_id){ %><a class="button <%= needsAttention?'':'secondary' %>" href="/admin/noticias/<%= item.article_id %>"><%= needsAttention?'Revisar matéria':'Editar matéria' %></a><% }else{ %><% if(['review','failed','queued'].includes(item.state)){ %><form method="post" action="/admin/automacao/itens/<%= item.id %>/criar-materia"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button">Criar matéria a partir deste item</button></form><% } %><a class="button secondary" href="<%= item.url %>" target="_blank" rel="noopener noreferrer">Conferir fonte</a><% } %><% if(!['published','discarded','processing'].includes(item.state)){ %><form method="post" action="/admin/automacao/itens/<%= item.id %>/descartar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Descartar item</button></form><% } %></div></article><% }) %></div>
<% if(!items.length){ %><div class="automation-empty"><h3><%= filter==='pending'?'Nenhuma pendência por aqui.':'Nenhum item encontrado.' %></h3><p><%= q||sourceFilter?'Experimente outro termo ou limpe os filtros.':filter==='pending'?'Os itens aguardando geração ficam na aba Na fila. As matérias publicadas estão no histórico.':'Os próximos itens desta situação aparecerão aqui.' %></p></div><% } %>
<% if(pages>1){ %><nav class="automation-pagination" aria-label="Páginas da fila"><% if(page>1){ %><a class="button secondary" href="<%= queueLink(filter,page-1) %>">Anterior</a><% } %><span>Página <%= page %> de <%= pages %></span><% if(page<pages){ %><a class="button secondary" href="<%= queueLink(filter,page+1) %>">Próxima</a><% } %></nav><% } %></section>
