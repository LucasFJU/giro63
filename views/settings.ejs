<%- include('header') %><main id="main" class="container admin-main"><div class="page-heading"><span class="tiny-label">IDENTIDADE E CONTATOS</span><h1>Configurações<span>.</span></h1><a class="underlined-link" href="/admin/portal">Busca, compartilhamento e privacidade</a></div><% if(error){ %><div class="form-error" role="alert"><%= error %></div><% } %><form method="post" class="form-card settings-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="two-columns"><div><label for="name">Nome do portal</label><input id="name" name="name" value="<%= settings.name %>" required maxlength="100"></div><div><label for="tagline">Assinatura</label><input id="tagline" name="tagline" value="<%= settings.tagline %>" maxlength="200"></div></div><label for="instagram">Endereço do Instagram</label><input id="instagram" name="instagram" type="url" value="<%= settings.instagram %>" placeholder="https://www.instagram.com/seuperfil/" maxlength="200"><p class="field-help">Deixe vazio enquanto o perfil não estiver definido. Nenhum perfil será inventado.</p><div class="two-columns"><div><label for="email">E-mail público</label><input id="email" type="email" name="email" value="<%= settings.email %>" maxlength="200"></div><div><label for="phone">Telefone público</label><input id="phone" name="phone" value="<%= settings.phone %>" maxlength="100"></div></div><% [['about','Sobre o portal'],['staff','Expediente'],['editorial','Política editorial']].forEach(([key,label])=>{ %><label for="<%= key %>"><%= label %></label><textarea id="<%= key %>" name="<%= key %>" rows="5" maxlength="6000"><%= settings[key] %></textarea><% }) %><button class="button">Salvar configurações</button></form></main><%- include('footer') %>
