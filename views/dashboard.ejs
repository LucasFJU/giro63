<%- include('header') %><main id="main" class="container admin-main"><div class="section-heading"><div><span class="tiny-label">REDAÇÃO GIRO63</span><h1><%= path==='/admin'?'Visão geral':'Matérias' %></h1><p><%= path==='/admin'?'Olá, '+user.name.split(' ')[0]+'. Acompanhe o trabalho da redação.':'Encontre, revise e acompanhe suas publicações.' %></p></div><a href="/admin/noticias/nova" class="button">+ Nova matéria</a></div><div class="stats-grid"><% [['Todas',stats.total,''],['Rascunhos',stats.draft||0,'draft'],['Em revisão',stats.review||0,'review'],['Publicadas',stats.published||0,'published']].forEach(([label,n,status])=>{ %><a class="stat stat-<%= status||'all' %>" href="/admin/materias?status=<%= status %>"><span><%= label %></span><strong><%= n %></strong><small><%= status==='review'&&n?'Aguardando decisão':status==='draft'?'Em produção':status==='published'?'No ar':'Ver matérias' %></small></a><% }) %></div><% if(path==='/admin'){ %><section class="attention-grid" aria-label="Atalhos de trabalho">
<a class="attention-card<%= (stats.review||0)?' is-highlight':'' %>" href="/admin/materias?status=review"><strong><%= stats.review||0 %></strong><span><b>Matérias em revisão</b><small>Revisar e decidir se vão ao ar</small></span></a>
<% if(user.role==='editor'){ %><a class="attention-card" href="/admin/automacao?status=published-review"><strong aria-hidden="true">→</strong><span><b>Publicadas para conferir</b><small>Conferir textos publicados pela automação</small></span></a><% } %>
<% if(user.role==='editor'){ %><a class="attention-card" href="/admin/audiencia"><strong aria-hidden="true">↗</strong><span><b>Audiência do portal</b><small>Visualizações, páginas mais lidas e tendência</small></span></a><% } %>
</section><% } %><section class="article-manager" aria-label="Lista de matérias"><nav class="view-tabs" aria-label="Visões da lista"><a href="/admin/materias"<%- path!=='/admin'&&status!=='archived'&&status!=='trash'?' class="is-active" aria-current="page"':'' %>>Todas</a><a href="/admin/materias?status=archived"<%- status==='archived'?' class="is-active" aria-current="page"':'' %>>Arquivadas</a><a href="/admin/materias?status=trash"<%- status==='trash'?' class="is-active" aria-current="page"':'' %>>Lixeira</a></nav><div class="table-heading"><h2><%= path==='/admin'?'Atividade recente':'Todas as matérias' %></h2><span id="article-count" role="status"><%= total %> matérias</span></div><% if(path!=='/admin'){ %><form class="admin-filters" method="get" action="/admin/materias"><div><label for="article-query">Buscar matéria</label><input id="article-query" name="q" type="search" value="<%= q %>" placeholder="Título, autor ou cidade"></div><div><label for="article-status">Situação</label><select id="article-status" name="status"><option value="">Todas</option><% [...Object.entries(labels),['checking','Publicado — conferir'],['archived','Arquivadas'],['trash','Lixeira']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= status===key?'selected':'' %>><%= label %></option><% }); %></select></div><div><label for="article-category">Editoria</label><select id="article-category" name="category"><option value="">Todas</option><% categories.forEach(([key,label])=>{ %><option value="<%= key %>" <%= category===key?'selected':'' %>><%= label %></option><% }); %></select></div><button class="button">Buscar</button><a href="/admin/materias">Limpar</a></form><% } %><div class="table-wrap"><table><thead><tr><th>Matéria</th><th>Categoria</th><th>Situação</th><th>Atualização</th><th>Ação</th></tr></thead><tbody><% articles.forEach(a=>{ %><tr data-status="<%= a.status %>" data-category="<%= a.category %>" data-search="<%= a.title+' '+(a.author_name||a.byline||'')+' '+a.city %>"><td><div class="admin-article-cell"><img src="<%= a.cover %>" alt="" width="60" height="45"><div><strong><%= a.title %></strong><span class="table-subtitle"><%= a.byline||a.author_name||'Redação' %><%= a.city?' · '+a.city:'' %><%= a.demo?' · Demonstração':'' %></span><% if(!a.archived_at&&!a.deleted_at&&['review','published'].includes(a.status)){ %><a class="article-art-link" href="/admin/noticias/<%= a.id %>/instagram">Criar arte para Instagram</a><% } %><% if(a.feedback&&a.status==='draft'){ %><span class="needs-changes">Ajustes solicitados</span><% } %></div></div></td><td><%= categoryName(a.category) %></td><td><span class="status status-<%= a.status %>"><%= a.deleted_at?'Na lixeira':a.archived_at?'Arquivada':a.status==='published'&&a.review_pending?'Publicado — conferir':labels[a.status] %></span></td><td class="table-date"><%= formatDate(a.updated_at) %></td><td><div class="article-row-actions"><% if(a.archived_at||a.deleted_at){ %><form method="post" action="/admin/materias/<%= a.id %>/restaurar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="article-action article-action-restore" aria-label="Restaurar <%= a.title %> como rascunho">Restaurar rascunho</button></form><% }else if(user.role==='editor'||a.status!=='published'){ %><a href="/admin/noticias/<%= a.id %>" class="article-action article-action-edit" aria-label="Editar <%= a.title %>">Editar</a><% [['arquivar','Arquivar','Arquivar esta matéria e retirá-la do site?'],['excluir','Excluir','Enviar esta matéria para a lixeira e retirá-la do site? Você poderá restaurá-la.']].forEach(([op,label,message])=>{ %><form method="post" action="/admin/materias/<%= a.id %>/<%= op %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="article-action article-action-<%= op %>" aria-label="<%= label %>: <%= a.title %>" data-confirm="<%= message %>"><%= label %></button></form><% }); %><% }else{ %><a href="/noticia/<%= a.slug %>" class="article-action article-action-edit" aria-label="Ler <%= a.title %>">Ler</a><% } %></div></td></tr><% }) %></tbody></table><% if(!articles.length){ %><div class="empty-state"><h2><%= Number(stats.total)?'Nenhuma matéria encontrada.':'A primeira matéria começa aqui.' %></h2><a href="<%= Number(stats.total)?'/admin/materias':'/admin/noticias/nova' %>" class="button"><%= Number(stats.total)?'Limpar filtros':'Criar matéria' %></a></div><% } %></div><p id="filter-empty" class="notice" hidden>Nenhuma matéria corresponde aos filtros.</p></section><% if(path!=='/admin'&&pages>1){ %><nav class="button-row" aria-label="Páginas das matérias"><% if(page>1){ %><a class="button secondary" href="<%= pageLink(page-1) %>">Anterior</a><% } %><span>Página <%= page %> de <%= pages %></span><% if(page<pages){ %><a class="button secondary" href="<%= pageLink(page+1) %>">Próxima</a><% } %></nav><% } %></main><%- include('footer') %>