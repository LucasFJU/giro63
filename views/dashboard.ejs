<%- include('header') %><main id="main" class="container admin-main"><div class="section-heading"><div><span class="tiny-label">REDAÇÃO GIRO63</span><h1><%= path==='/admin'?'Visão geral':'Matérias' %></h1><p><%= path==='/admin'?'Olá, '+user.name.split(' ')[0]+'. Acompanhe o trabalho da redação.':'Encontre, revise e acompanhe suas publicações.' %></p></div><a href="/admin/noticias/nova" class="button">+ Nova matéria</a></div><div class="stats-grid"><% [['Todas',articles.length,''],['Rascunhos',articles.filter(a=>a.status==='draft').length,'draft'],['Em revisão',articles.filter(a=>a.status==='review').length,'review'],['Publicadas',articles.filter(a=>a.status==='published').length,'published']].forEach(([label,n,status])=>{ %><a class="stat" href="/admin/materias?status=<%= status %>"><span><%= label %></span><strong><%= n %></strong><small>Ver matérias</small></a><% }) %></div><% if(path==='/admin'){ %><section class="workflow-summary"><div><span class="tiny-label">ROTINA EDITORIAL</span><h2>Da pauta à publicação</h2></div><p><strong>01 · Escreva</strong>Salve o texto e reúna as fontes no rascunho.</p><p><strong>02 · Revise</strong>Envie para revisão e acompanhe as orientações.</p><p><strong>03 · Publique</strong>O editor confere os dados e publica no portal.</p></section><% } %><section class="article-manager" aria-label="Lista de matérias"><div class="table-heading"><h2><%= path==='/admin'?'Atividade recente':'Todas as matérias' %></h2><span id="article-count" role="status"><%= articles.length %> matérias</span></div><div class="admin-filters"><div><label for="article-search">Pesquisar</label><input id="article-search" type="search" placeholder="Título, autor ou cidade"></div><div><label for="status-filter">Situação</label><select id="status-filter"><option value="">Todas as situações</option><% Object.entries(labels).forEach(([key,name])=>{ %><option value="<%= key %>"><%= name %></option><% }) %></select></div><div><label for="category-filter">Categoria</label><select id="category-filter"><option value="">Todas as categorias</option><% categories.forEach(([slug,name])=>{ %><option value="<%= slug %>"><%= name %></option><% }) %></select></div><button type="button" class="text-button" id="clear-filters">Limpar filtros</button></div><div class="table-wrap"><table><thead><tr><th>Matéria</th><th>Categoria</th><th>Situação</th><th>Atualização</th><th>Ação</th></tr></thead><tbody><% articles.forEach(a=>{ %><tr data-status="<%= a.status %>" data-category="<%= a.category %>" data-search="<%= a.title+' '+(a.author_name||a.byline||'')+' '+a.city %>"><td><div class="admin-article-cell"><img src="<%= a.cover %>" alt="" width="60" height="45"><div><strong><%= a.title %></strong><span class="table-subtitle"><%= a.byline||a.author_name||'Redação' %><%= a.city?' · '+a.city:'' %><%= a.demo?' · Demonstração':'' %></span><% if(a.feedback&&a.status==='draft'){ %><span class="needs-changes">Ajustes solicitados</span><% } %></div></div></td><td><%= categoryName(a.category) %></td><td><span class="status status-<%= a.status %>"><%= labels[a.status] %></span></td><td class="table-date"><%= formatDate(a.updated_at) %></td><td><% if(user.role==='editor'||a.status!=='published'){ %><a href="/admin/noticias/<%= a.id %>" class="table-action">Editar</a><% }else{ %><a href="/noticia/<%= a.slug %>" class="table-action">Ler</a><% } %></td></tr><% }) %></tbody></table><% if(!articles.length){ %><div class="empty-state"><h2>A primeira matéria começa aqui.</h2><a href="/admin/noticias/nova" class="button">Criar matéria</a></div><% } %></div><p id="filter-empty" class="notice" hidden>Nenhuma matéria corresponde aos filtros.</p></section></main><%- include('footer') %>