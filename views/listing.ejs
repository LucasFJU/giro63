<%- include('header') %><main id="main" class="container listing-main"><div class="breadcrumb"><a href="/">Início</a><span>/</span><span><%= heading %></span></div><div class="page-heading"><span class="tiny-label">GIRO63 · INFORMAÇÃO QUE APROXIMA</span><h1><%= heading %></h1><p><%= intro %></p></div><% if(base==='/busca'){ %><form action="/busca" class="reader-search-form" role="search"><div class="search-term"><label for="listing-q">Assunto</label><input id="listing-q" name="q" value="<%= q %>" placeholder="Ex.: educação, saúde ou turismo" maxlength="100"></div><div><label for="search-category">Editoria</label><select id="search-category" name="editoria"><option value="">Todas as editorias</option><% categories.forEach(([slug,name])=>{ %><option value="<%= slug %>" <%= categoryFilter===slug?'selected':'' %>><%= name %></option><% }) %></select></div><div><label for="search-city">Cidade ou região</label><select id="search-city" name="cidade"><option value="">Todo o Tocantins</option><% cities.forEach(city=>{ %><option value="<%= slugify(city) %>" <%= cityFilter===slugify(city)?'selected':'' %>><%= city %></option><% }) %></select></div><div><label for="search-tag">Assunto / tag</label><select id="search-tag" name="tag"><option value="">Todos os assuntos</option><% allTags.forEach(tag=>{ %><option value="<%= tag.slug %>" <%= tagFilter===tag.slug?'selected':'' %>><%= tag.name %></option><% }) %></select></div><button class="button">Buscar</button><% if(q||categoryFilter||cityFilter){ %><a href="/busca" class="underlined-link">Limpar filtros</a><% } %></form><% } %><div class="result-line"><span><%= total %> <%= total===1?'publicação encontrada':'publicações encontradas' %></span><span>MAIS RECENTES PRIMEIRO</span></div><% if(articles.length){ %><div class="news-grid" data-count="<%= articles.length %>"><% articles.forEach(item=>{ %><%- include('card',{item}) %><% }) %></div><% }else{ %><div class="empty-state"><h2>Nenhuma história por aqui ainda.</h2><p><%= base==='/busca'?'Tente um termo mais curto ou remova um dos filtros.':'A redação ainda não publicou matérias nesta seleção.' %></p><a class="button" href="/ultimas">Ver últimas notícias</a></div><% } %><% if(pages>1){ %><nav class="pagination" aria-label="Paginação"><% if(page>1){ %><a href="<%= pageLink(page-1) %>" rel="prev">Anterior</a><% } %><span>Página <%= page %> de <%= pages %></span><% if(page<pages){ %><a href="<%= pageLink(page+1) %>" rel="next">Próxima</a><% } %></nav><% } %><%- include('ad',{position:'middle'}) %></main><%- include('footer') %>