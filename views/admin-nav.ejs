<%
  const icons = {
    '': '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
    materias: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
    automacao: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
    categorias: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
    tags: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5"/>',
    audiencia: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
    publicidade: '<path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15 9a4 4 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"/>',
    equipe: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>',
    configuracoes: '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
    portal: '<path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z"/>'
  };
  const icon = key => '<svg class="nav-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + icons[key] + '</svg>';
  const sections = [
    ['Redação', [['', 'Visão geral'], ['materias', 'Matérias']].concat(user.role === 'editor' ? [['automacao', 'Automação'], ['instagram', 'Instagram'], ['categorias', 'Categorias'], ['tags', 'Tags']] : [])]
  ];
  if (user.role === 'editor') {
    sections.push(['Gestão', [['audiencia', 'Audiência'], ['publicidade', 'Publicidade']]]);
    sections.push(['Administração', [['equipe', 'Equipe e acessos'], ['configuracoes', 'Configurações'], ['portal', 'Busca e privacidade']]]);
  }
  const initials = user.name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase();
  const isCurrent = (url, href) => path === href || (url === 'materias' && path.startsWith('/admin/noticias') && !path.includes('/instagram')) || (url === 'instagram' && /^\/admin\/noticias\/[^/]+\/instagram/.test(path)) || (url !== '' && path.startsWith(href + '/'));
%>
<aside class="editorial-nav" aria-label="Navegação da redação">
  <a href="/admin" class="editorial-brand" aria-label="Giro63 — painel da redação">GIRO<span>63</span><small>PAINEL DA REDAÇÃO</small></a>
  <a class="editorial-create" href="/admin/noticias/nova"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg><span class="create-label">Criar matéria</span></a>
  <button type="button" class="admin-menu-toggle" aria-expanded="false" aria-controls="admin-menu-links">Menu da redação</button>
  <div id="admin-menu-links">
    <% sections.forEach(([caption, links]) => { %>
      <span class="nav-caption"><%= caption %></span>
      <% links.forEach(([url, label]) => { const href = '/admin' + (url ? '/' + url : ''); const current = isCurrent(url, href); %>
        <a href="<%= href %>" class="<%= current ? 'current' : '' %>"<%- current ? ' aria-current="page"' : '' %>><%- icon(url) %><span><%= label %></span></a>
      <% }); %>
    <% }); %>
  </div>
  <a href="/" target="_blank" rel="noopener" class="nav-portal"><svg class="nav-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg><span>Abrir portal</span><span class="sr-only"> (abre em nova aba)</span></a>
  <div class="editorial-account">
    <span class="avatar" aria-hidden="true"><%= initials %></span>
    <div class="account-info"><strong><%= user.name %></strong><span><%= user.role === 'editor' ? 'Editor' : 'Autor' %></span></div>
    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="logout-button" title="Sair do painel"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span class="logout-label">Sair do painel</span></button></form>
  </div>
</aside>
