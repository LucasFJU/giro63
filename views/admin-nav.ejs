<aside class="editorial-nav" aria-label="Navegação da redação"><a href="/admin" class="editorial-brand">GIRO<span>63</span><small>PAINEL DA REDAÇÃO</small></a><a class="editorial-create" href="/admin/noticias/nova">+ Criar matéria</a><button type="button" class="admin-menu-toggle" aria-expanded="false" aria-controls="admin-menu-links">Menu da redação</button><div id="admin-menu-links"><span class="nav-caption">REDAÇÃO</span><% const groups=[[['','Visão geral'],['materias','Matérias']],...(user.role==='editor'?[[['automacao','Automação'],['categorias','Categorias'],['tags','Tags']],[['audiencia','Audiência'],['publicidade','Publicidade']],[['equipe','Equipe e acessos'],['configuracoes','Configurações'],['portal','Busca e privacidade']]]:[])];groups.forEach((links,index)=>{if(index===2){ %><span class="nav-caption">GESTÃO</span><% }if(index===3){ %><span class="nav-caption">ADMINISTRAÇÃO</span><% }links.forEach(([url,label])=>{const href='/admin'+(url?'/'+url:''); %><a href="<%= href %>" class="<%= path===href||(url==='materias'&&path.startsWith('/admin/noticias'))?'current':'' %>"><%= label %></a><% });}); %></div><a href="/" target="_blank" rel="noopener" class="nav-portal">Abrir portal</a><div class="editorial-account"><strong><%= user.name %></strong><span><%= user.role==='editor'?'Editor':'Autor' %></span><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Sair do painel</button></form></div></aside>