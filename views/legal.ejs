<%- include('header') %><main id="main" class="container institutional-main"><div class="breadcrumb"><a href="/">Início</a><span>/</span><%= title %></div><div class="page-heading"><span class="tiny-label">TRANSPARÊNCIA GIRO63</span><h1><%= title %></h1></div><% if(!ready){ %><div class="notice"><strong>Rascunho — revisão pendente</strong><p>Texto em preparação. Os dados do responsável e a revisão precisam ser concluídos antes do lançamento.</p></div><% } %><div class="prose legal-content"><dl><dt>Responsável pelo portal</dt><dd><%= settings.legal_owner||'A preencher pela redação' %></dd><dt>Contato de privacidade</dt><dd><% if(settings.privacy_email){ %><a href="mailto:<%= settings.privacy_email %>"><%= settings.privacy_email %></a><% }else{ %>A preencher pela redação<% } %></dd></dl><% if(settings[legalKey+'_updated']){ %><p class="legal-date">Atualizado em <%= formatDate(settings[legalKey+'_updated']) %></p><% } %><% settings[legalKey+'_text'].split(/\n\s*\n/).filter(Boolean).forEach(block=>{const lines=block.split('\n'); %><section><h2><%= lines.shift() %></h2><p class="preserve-lines"><%= lines.join('\n') %></p></section><% }) %><p><a href="/pagina/<%= legalKey==='privacy'?'termos-de-uso':'privacidade' %>"><%= legalKey==='privacy'?'Termos de uso':'Política de privacidade' %></a></p><button type="button" class="button secondary cookie-preferences" hidden>Preferências de cookies</button></div></main><%- include('footer') %>
