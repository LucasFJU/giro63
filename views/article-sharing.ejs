<% const articleUrl=metadata?.url||'http://localhost:'+(process.env.PORT||3000)+'/noticia/'+article.slug; const articleAuthor=article.byline||article.author_name||user?.name||'Redação Giro63'; %>
<section class="article-social" aria-label="Compartilhamento e autoria" data-share-title="<%= article.title %>">
  <% if(!preview){ %><div class="article-share-row"><h2 id="article-social-title"><%- include('share-icon',{icon:'share'}) %><span>Compartilhar este artigo</span></h2><div class="article-share-buttons" role="group" aria-label="Compartilhar matéria">
    <a class="share-social share-facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(articleUrl) %>" data-share-network="facebook" aria-label="Compartilhar no Facebook" target="_blank" rel="noopener noreferrer"><%- include('share-icon',{icon:'facebook'}) %><span>Facebook</span></a>
    <a class="share-social share-x" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>&url=<%= encodeURIComponent(articleUrl) %>" data-share-network="x" aria-label="Compartilhar no X" target="_blank" rel="noopener noreferrer"><%- include('share-icon',{icon:'x'}) %></a>
    <a class="share-social share-whatsapp" href="https://wa.me/?text=<%= encodeURIComponent(article.title+' '+articleUrl) %>" data-share-network="whatsapp" aria-label="Compartilhar no WhatsApp" target="_blank" rel="noopener noreferrer"><%- include('share-icon',{icon:'whatsapp'}) %></a>
    <button class="share-social share-copy" type="button" aria-label="Copiar link da matéria"><%- include('share-icon',{icon:'link'}) %></button>
    <button class="share-social share-print" type="button" aria-label="Imprimir matéria"><%- include('share-icon',{icon:'print'}) %></button>
    <div class="share-more-wrap"><button class="share-social share-more-toggle" type="button" aria-label="Mais opções de compartilhamento" aria-expanded="false" aria-controls="article-share-more"><%- include('share-icon',{icon:'more'}) %></button><div id="article-share-more" class="share-more-panel" hidden><a href="mailto:?subject=<%= encodeURIComponent(article.title) %>&body=<%= encodeURIComponent(articleUrl) %>" data-share-network="email">Enviar por e-mail</a><a href="https://t.me/share/url?url=<%= encodeURIComponent(articleUrl) %>&text=<%= encodeURIComponent(article.title) %>" data-share-network="telegram" target="_blank" rel="noopener noreferrer">Compartilhar no Telegram</a><button type="button" class="share-native" hidden>Compartilhar pelo dispositivo</button></div></div>
  </div></div><p class="share-feedback" role="status" aria-live="polite"></p><div class="share-link-fallback" hidden><label for="article-share-url">Link da matéria</label><input id="article-share-url" type="text" readonly value="<%= articleUrl %>"></div><% } %>
  <div class="article-author-card"><img src="/images/giro63-simbolo-oficial.png" alt="Giro63" width="80" height="80" loading="lazy"><div><p class="author-byline">Por <strong><%= articleAuthor %></strong></p><p class="author-description">Conteúdo <%= article.demo?'demonstrativo do':'publicado no' %> <%= settings.name %>.</p></div></div>
</section>
