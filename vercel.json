{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node scripts/deploy-media.js && node scripts/check-editorial.js",
  "functions": {
    "index.js": {
      "includeFiles": "views/**",
      "excludeFiles": "{data,backups,exports,public/uploads,migration-assets}/**",
      "maxDuration": 60
    }
  }
}
