# Model only. Never place real credentials in this file.
# The current npm start remains the local SQLite application.
# These keys are reserved for the cloud migration under preparation.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=giro63-media
SESSION_SECRET=
PUBLIC_URL=
ALLOW_INDEXING=false

# Server-only Gemini settings. Never include real values in this template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Instagram API with Instagram Login, server-only app credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v24.0

# WeatherAPI Free — server only, commercial use allowed.
WEATHER_API_KEY=
